DATABASE_URL="postgresql://aps:aps_dev_senha@localhost:5433/aps?schema=public"
PORT=3333

# Provedor de IA: gemini | ollama
AI_PROVIDER=gemini
AI_TIMEOUT_MS=60000

# Gemini (chave gratuita em https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Ollama (local). Baixe o modelo antes: ollama pull llama3.2:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Reserva: se o provedor principal falhar, tenta este (deixe vazio para desligar)
AI_FALLBACK=ollama
GEMINI_TIMEOUT_MS=15000
OLLAMA_TIMEOUT_MS=120000

# Assistente do regimento (busca por embeddings). Trocar o provedor ou o modelo exige "Reindexar" na tela do síndico.
EMBEDDING_PROVIDER=gemini
# Se o principal falhar (ex.: acabou a cota grátis do Gemini), indexa e busca com este: ollama (padrão), gemini ou nenhum.
# Para o Ollama funcionar: docker exec aps-ollama ollama pull bge-m3
EMBEDDING_FALLBACK=ollama
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBEDDING_TIMEOUT_MS=30000
# Se usar EMBEDDING_PROVIDER=ollama, baixe antes: ollama pull bge-m3
OLLAMA_EMBEDDING_MODEL=bge-m3
# Busca: quantos trechos vão para a IA e a similaridade mínima para considerar que o regimento cobre a pergunta
RAG_TOP_K=4
RAG_LIMIAR=0.55
# Mantém o modelo do Ollama carregado entre pedidos (o servidor também o aquece ao iniciar)
OLLAMA_KEEP_ALIVE=30m

# Login. O JWT_SECRET precisa ter pelo menos 32 caracteres e ficar só no seu .env (gere um novo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_DURACAO=8h
# Conta do síndico: criada na primeira vez que o servidor sobe e atualizada a cada início a partir daqui.
# A senha precisa ter 8 ou mais caracteres. Se ela tiver # (ou espaços), coloque entre aspas duplas: SINDICO_SENHA="minha#senha-forte"
SINDICO_NOME=Síndico
SINDICO_EMAIL=sindico@condominio.local
SINDICO_SENHA=troque-esta-senha
# Tentativas de login/cadastro por IP a cada 15 minutos
AUTH_RATE_LIMIT=20
